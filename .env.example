# ==================== 数据库 ====================
# DB_TYPE: mysql（默认，生产推荐） | sqlite（本地免服务体验）
DB_TYPE=mysql

# --- MySQL 配置 ---
# 本地直连 MySQL 服务时用 localhost；用 docker-compose 时改为容器服务名 mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=ecommerce

# --- SQLite 配置（仅 DB_TYPE=sqlite 时生效）---
DB_PATH=database/ecommerce.db

# ==================== LLM ====================
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
